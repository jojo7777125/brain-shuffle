# Copy this file to .env.local and fill it in. .env.local is git-ignored. NEVER commit real keys.
# On Vercel, add the same name under Project → Settings → Environment Variables.

# Server-only (no VITE_ prefix = never bundled into the browser)
ANTHROPIC_API_KEY=

# Set to true to skip the AI entirely and always use the offline sorter
VITE_USE_MOCK=false
